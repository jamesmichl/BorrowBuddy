# Vercel Preview / Production. Set values in the dashboard, server-side only.
BORROWBUDDY_MODE=online-demo
BORROWBUDDY_POSTGRES_URL=
# Optional PEM of the database provider's root CA if required by TLS validation.
BORROWBUDDY_POSTGRES_CA=
# Optional OCR threshold (0–100).
BORROWBUDDY_OCR_CONFIDENCE=75
# Only for real email delivery outside online-demo.
BORROWBUDDY_APP_URL=
BORROWBUDDY_MAIL_FROM=
BORROWBUDDY_MAIL_KEY=
