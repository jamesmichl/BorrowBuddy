import assert from "node:assert/strict";
import { beforeEach, test } from "node:test";
import { domain, makeSeed } from "../server/domain.ts";
import { readState, writeState } from "../server/database.ts";
import { confirmEmail, register, signIn } from "../server/auth.ts";
import { mkdtempSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { depositState, filterItems, jakartaInput, quote, type Item } from "../lib/loans.ts";
import { readFileSync } from "node:fs";
import { inspectPhoto } from "../server/ocr.ts";
const sampleKtm = "data:image/png;base64," + readFileSync(new URL("../server/samples/match.png",import.meta.url)).toString("base64");
process.env.BORROWBUDDY_DEMO_SEED = "1";
