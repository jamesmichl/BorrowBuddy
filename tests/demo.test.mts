test("pengajuan, pembayaran, serah terima, pengembalian, dan refund penuh", async () => {
  asActor("raka");
  const charger = snapshot().items.find((item) => item.id === "charger")!;
  const point = charger.points[0];
  assert.throws(() => requestLoan(charger.id, at(50), at(49), point), /setelah/);
  assert.throws(() => requestLoan(charger.id, at(-24), at(1), point), /lewat/);
  assert.throws(() => requestLoan(charger.id, at(50), at(150), point), /maksimal/);
  assert.throws(() => requestLoan(charger.id, at(50), at(51), "Lokasi palsu"), /titik/);
  const start = at(50);
  const end = at(75);
  assert.deepEqual(quote(charger, start, end), { days: 2, rental: 20000, servicePercent: 10, service: 2000, deposit: 30000, total: 52000 });
  const id = requestLoan(charger.id, start, end, point);
  const loan = () => snapshot().loans.find((entry) => entry.id === id)!;
  assert.throws(() => requestLoan(charger.id, at(51), at(52), point), /berbenturan/);
  assert.throws(() => changeStatus(id, "approved"), /Aksi/);
  asActor("naya");
  changeStatus(id, "approved");
  assert.throws(() => changeStatus(id, "paid"), /QRIS/);
  await assert.rejects(confirmSimulatedPayment("loan", id, "naya"), /Tagihan/);
  asActor("raka");
  const receipt = await confirmSimulatedPayment("loan", id, "raka");
  assert.equal(receipt.deposit, 30000);
  assert.equal(receipt.commission, 0);
  assert.equal(receipt.owner, "naya");
  assert.equal(receipt.ownerProceeds, 20000);
  assert.equal(receipt.ownerProceeds! + receipt.service + receipt.deposit, receipt.total);
  assert.deepEqual([receipt.rental, receipt.servicePercent, receipt.service, receipt.total], [20000, 10, 2000, 52000]);
  assert.equal(receipt.promotionRevenue, 0);
  assert.deepEqual(await confirmSimulatedPayment("loan", id, "raka"), receipt);
  assert.match(depositState(loan()), /ditahan sementara/);
  asActor("naya");
  changeStatus(id, "handover");
  assert.throws(() => changeStatus(id, "cancelled"), /Aksi/);
  asActor("raka");
  changeStatus(id, "active");
  changeStatus(id, "returning");
  asActor("naya");
  changeStatus(id, "completed");
  assert.equal(loan().status, "completed");
  assert.equal(Object.keys(loan().history).length, 7);
  assert.match(depositState(loan()), /dikembalikan 100%/);
  asActor("admin");
  assert.equal(cashReport(adminRecords().receipts).balance, 2000);
  assert.throws(() => repo().refundServiceFee(id, "Pengembalian normal"), /dibatalkan/);
});

test("preview dan snapshot sewa memakai durasi, pembulatan Rupiah dan tarif saat dipesan", async () => {
  asActor("raka");
  const charger = snapshot().items.find(i => i.id === "charger")!;
  const start = at(50), end = at(74);
  const daily = quote(charger, start, end);
  assert.deepEqual([daily.days, daily.service, daily.total], [1, 1000, 41000]);
  assert.equal(quote(charger, start, at(75)).total, 52000);
  assert.equal(quote({ ...charger, rate: 10005 }, start, end).service, 1001);
  assert.equal(quote({ ...charger, rate: 10004 }, start, end).service, 1000);
  const free = quote({ ...charger, rate: 0 }, start, end);
  assert.deepEqual([free.service, free.total], [0, charger.deposit]);
  const id = requestLoan(charger.id, start, end, charger.points[0]);
  const initialPercent = demoConfig.servicePercent;
  try {
    demoConfig.servicePercent = 15;
    asActor("naya");
    addItem({ ...charger, rate: 16000 }, 200000, charger.id);
    changeStatus(id, "approved");
    asActor("raka");
    const paid = await confirmSimulatedPayment("loan", id, "raka");
    assert.deepEqual([paid.rental, paid.service, paid.servicePercent, paid.deposit, paid.total], [10000, 1000, 10, 30000, 41000]);
    const next = requestLoan(charger.id, at(100), at(101), charger.points[0]);
    const newLoan = snapshot().loans.find(l => l.id === next)!;
    assert.deepEqual([newLoan.rental, newLoan.service, newLoan.servicePercent, newLoan.deposit, newLoan.total], [16000, 2400, 15, 100000, 118400]);
  } finally { demoConfig.servicePercent = initialPercent; }
});

test("kas simulasi membukukan pembayaran dan refund sekali serta memisahkan deposit dan promosi", async () => {
  const report = () => cashReport(readState().receipts);
  asActor("raka");
  const id = requestLoan("charger", at(10), at(58), "alsut-lobi");
  await assert.rejects(confirmSimulatedPayment("loan", id, "raka"), /Tagihan/);
  assert.equal(report().entries.length, 0);
  asActor("naya");
  changeStatus(id, "approved");
  assert.equal(report().balance, 0);
  asActor("raka");
  const original = await confirmSimulatedPayment("loan", id, "raka");
  await confirmSimulatedPayment("loan", id, "raka");
  const promotion = createPromotion("tripod");
  const promoted = await confirmSimulatedPayment("promotion", promotion.id, "raka");
  assert.equal(promoted.service, 0);
  assert.deepEqual(report().totals, { service: 2000, refund: 0, commission: 0, promotion: 10000 });
  changeStatus(id, "cancelled");
  assert.equal(report().balance, 12000);
  assert.match(depositState(snapshot().loans.find(row => row.id === id)!), /dikembalikan 100%/);
  assert.throws(() => repo().refundServiceFee(id, "Uji"), /admin/);
  asActor("admin");
  assert.throws(() => repo().refundServiceFee(id, " "), /alasan/);
  repo().refundServiceFee(id, "Pembatalan disetujui");
  repo().refundServiceFee(id, "Klik ulang");
  const cash = report();
  assert.deepEqual(cash.totals, { service: 2000, refund: -2000, commission: 0, promotion: 10000 });
  assert.equal(cash.balance, 10000);
  assert.equal(cash.entries.length, 3);
  const { serviceRefund, ...paid } = readState().receipts.find(r => r.id === id)!;
  assert.deepEqual(paid, original);
  assert.equal(serviceRefund?.actor, "admin");
  assert.equal(serviceRefund?.reason, "Pembatalan disetujui");
  assert.equal(serviceRefund?.amount, 2000);
  asActor("raka");
  await confirmSimulatedPayment("loan", id, "raka");
  assert.equal(report().entries.length, 3);
});

