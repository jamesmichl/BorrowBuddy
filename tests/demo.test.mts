});

test("barang baru, penolakan, pembatalan setelah bayar, dan data tersimpan", async () => {
  asActor("naya");
  const item: Omit<Item, "owner" | "id"> = {
    name: "Proyektor demo", tile: 0, category: "Elektronik", campus: "Senayan", description: "Untuk kegiatan kampus.",
    condition: "Baik", contents: "Proyektor dan adaptor", points: ["senayan-lobi"], rate: 5000, deposit: 10000, maxDays: 2,
  };
  const itemId = addItem(item, 20000);
  assert.throws(() => requestLoan(itemId, at(5), at(10), "senayan-lobi"), /milik/);
  asActor("raka");
  const rejected = requestLoan(itemId, at(5), at(10), "senayan-lobi");
  asActor("naya");
  changeStatus(rejected, "rejected");
  asActor("raka");
  const cancelled = requestLoan(itemId, at(5), at(10), "senayan-lobi");
  asActor("naya");
  changeStatus(cancelled, "approved");
