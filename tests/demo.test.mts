process.env.BORROWBUDDY_DB = join(mkdtempSync(join(tmpdir(), "bb-domain-")), "test.sqlite");
let actor = "";
beforeEach(() => { writeState(makeSeed()); actor = ""; });
const asActor = (id: string) => { actor = id; };
const repo = () => domain(readState(), actor, writeState);
function method<K extends keyof ReturnType<typeof domain>>(key: K) {
  type Method = ReturnType<typeof domain>[K];
  return (...args: Parameters<Method>) => (repo()[key] as (...args: Parameters<Method>) => ReturnType<Method>)(...args);
}
const listingValuation = method("listingValuation"), removeListing = method("removeListing"), addItem = method("addItem"), adminRecords = method("adminRecords");
const changeStatus = method("changeStatus"), createPromotion = method("createPromotion"), requestLoan = method("requestLoan");
const reviewVerification = (id: string, decision: "approved" | "rejected", reason = "") => repo().reviewVerification(id,decision,reason,readState().verifications[id]?.[0]?.id ?? "");
const verificationDocument = method("verificationDocument"), snapshot = method("view");
const confirmSimulatedPayment = async (kind: "loan"|"promotion", id: string, payer: string, time = new Date()) => repo().completeSimulatedPayment(kind,id,payer,time);
const paymentReceipt = (kind: "loan"|"promotion", id: string) => snapshot().receipts.find(r => r.kind === kind && r.id === id);
const signup = async (...args: Parameters<typeof register>) => register(...args);
const login = async (email: string, password: string) => { actor = (await signIn(email,password)).id; };
const at = (hours: number) => jakartaInput(new Date(Date.now() + hours * 3600000));

test("estimasi privat, deposit otomatis, lokasi per kampus, dan kesepakatan pesanan", () => {
  asActor("naya");
  const base = snapshot().items.find((item) => item.id === "hdmi")!;
  const draft = { ...base, rate: 0, deposit: 1, points: ["anggrek-kantin"] };
  const id = addItem(draft, 200000);
  assert.equal(listingValuation(id), 200000);
  assert.equal(depositFor(200001), 100001);
  for (const value of [0, -1, 1.1, NaN, Infinity]) assert.throws(() => addItem(draft, value), /positif/);
  assert.throws(() => addItem({ ...draft, campus: "Bekasi" }, 200000), /sesuai kampus/);
  asActor("raka");
  assert.throws(() => listingValuation(id), /admin/);
  assert.doesNotMatch(JSON.stringify(snapshot()), /estimatedValue|200000/);
  assert.throws(() => requestLoan(id, at(200), at(201), "anggrek-perpustakaan"), /titik/);
  const first = requestLoan(id, at(200), at(201), "anggrek-kantin");
  asActor("naya");
  addItem({ ...draft, rate: 10000, campus: "Bekasi", points: ["bekasi-lobi"] }, 240001, id);
  asActor("admin");
  assert.equal(listingValuation(id), 240001);
  asActor("raka");
  const second = requestLoan(id, at(203), at(204), "bekasi-lobi");
  const agreed = (order: string) => {
    const loan = snapshot().loans.find((entry) => entry.id === order)!;
    return [loan.deposit, loan.rental, loan.pointId, loan.point];
  };
  assert.deepEqual(agreed(first), [100000, 0, "anggrek-kantin", "Kantin Anggrek"]);
  assert.deepEqual(agreed(second), [120001, 10000, "bekasi-lobi", "Lobi utama BINUS Bekasi"]);
  const old = readState();
  delete old.valuations[id];
  old.items.find((row) => row.id === id)!.points = ["Lobi utama BINUS Bekasi", "Parkiran lama"];
  writeState(old);
  assert.deepEqual(migratePoints("Bekasi", ["  LOBI utama BINUS Bekasi "]), ["bekasi-lobi"]);
  assert.equal(snapshot().items.find((item) => item.id === id)?.bookingReady, false);
  assert.throws(() => requestLoan(id, at(205), at(206), "bekasi-lobi"), /melengkapi/);
  assert.deepEqual(agreed(first), [100000, 0, "anggrek-kantin", "Kantin Anggrek"]);
});

