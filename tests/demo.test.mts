  assert.match(depositState(persisted.loans[0]), /dikembalikan 100%/);
});

test("akun tanpa KTM, konfirmasi email, batas akses, privasi, dan pengajuan ulang", async () => {
  asActor("");
  await assert.rejects(signup("Mahasiswa Demo", "demo@example.invalid", "password123", "password123"), /email kampus/);
  await assert.rejects(signup("Mahasiswa Demo", "uji@binus.ac.id", "password123", "berbeda123"), /tidak sama/);
  const token = await signup("Mahasiswa Demo", "Uji@binus.ac.id", "password123", "password123");
  await assert.rejects(login("uji@binus.ac.id", "password123"), /Konfirmasi email/);
  await confirmEmail(token);
  await login("uji@binus.ac.id", "password123");
  const { items } = snapshot();
  const id = actor;
  const item = items.find(({ id }) => id === "hdmi")!;
  assert.equal(snapshot().profile?.confirmed, true);
  assert.equal(snapshot().verificationStatus, "none");
  assert.throws(() => requestLoan(item.id, at(20), at(21), item.points[0]), /Verifikasi mahasiswa/);
  assert.throws(() => addItem(item, 20000), /Verifikasi mahasiswa/);
  const check = await inspectPhoto("1234567890",sampleKtm);
  const submitVerification = (nim: string, campus: "Kemanggisan"|"Alam Sutera", photo: string) => repo().submitVerification(nim,campus,photo,check);
  assert.throws(() => submitVerification("abcd", "Kemanggisan", sampleKtm), /NIM/);
  assert.throws(() => submitVerification("0000000000", "Kemanggisan", "data:image/gif;base64,AAA"), /JPG/);
  assert.throws(() => submitVerification("0000000000", "Kemanggisan", "data:image/png;base64," + "A".repeat(2_000_100)), /1,5 MB/);
  submitVerification("1234567890", "Kemanggisan", sampleKtm);
  assert.equal(snapshot().verificationStatus, "pending");
  assert.equal(verificationDocument(id)?.photo, sampleKtm);
  assert.doesNotMatch(JSON.stringify(snapshot()), /credential/);
  assert.throws(() => reviewVerification(id, "approved"), /admin/);
  asActor("naya");
  assert.throws(() => verificationDocument(id), /admin/);
  assert.throws(() => adminRecords(), /admin/);
  assert.doesNotMatch(JSON.stringify(snapshot()), /ktm-demo|0000000000/);
  asActor("admin");
  assert.throws(() => reviewVerification(id, "rejected"), /alasan/);
  reviewVerification(id, "rejected", "Foto demo perlu diperjelas.");
  await login("uji@binus.ac.id", "password123");
  assert.equal(snapshot().verificationStatus, "rejected");
  assert.equal(verificationDocument(id)?.reason, "Foto demo perlu diperjelas.");
  submitVerification("1234567890", "Alam Sutera", sampleKtm);
  asActor("admin");
  reviewVerification(id, "approved");
  const records = adminRecords().history.filter(row => row.id === id).map(row => row.entry);
  assert.deepEqual(records.map((entry) => entry.status), ["approved", "rejected"]);
  assert.ok(records.every((entry) => entry.reviewer === "admin" && entry.reviewedAt));
  await login("uji@binus.ac.id", "password123");
  assert.equal(snapshot().verificationStatus, "approved");
  assert.ok(addItem({ ...item, name: "Kabel demo" }, 25000));
  assert.ok(requestLoan(item.id, at(40), at(41), item.points[0]));
});

