test("pembelian promosi berulang, pendapatan terpisah, filter, dan batas waktu", async () => {
  asActor("raka");
  const start = new Date("2030-01-01T00:00:00Z");
  const day = 86400000;
  const first = createPromotion("tripod").id;
  assert.equal(createPromotion("tripod").id, first);
  assert.equal(qrPayload(first), `BORROWBUDDY_DEMO:${first}`);
  const [one, repeated] = await Promise.all([confirmSimulatedPayment("promotion", first, "raka", start), confirmSimulatedPayment("promotion", first, "raka", start)]);
  assert.deepEqual(one, repeated);
  assert.deepEqual([one.promotionRevenue, one.commission, one.deposit], [10000, 0, 0]);
  const early = new Date(start.getTime() + 3 * day);
  const extension = createPromotion("tripod").id;
  await confirmSimulatedPayment("promotion", extension, "raka", early);
  const coat = createPromotion("coat").id;
  await confirmSimulatedPayment("promotion", coat, "raka", start);
  const { items, promotions } = snapshot();
  const original = promotions.find((order) => order.id === first)!;
  const extra = promotions.find((order) => order.id === extension)!;
  assert.equal(extra.startsAt, original.endsAt);
  assert.equal(Date.parse(extra.endsAt!), start.getTime() + 14 * day);
  assert.equal(promotionStatus(extra, early.getTime()), "Terjadwal");
  assert.deepEqual([...activePromotions(items, promotions, early.getTime()).keys()].sort(), ["coat", "tripod"]);
  assert.deepEqual([...activePromotions(filterItems(items, "", "", "Senayan", "paid"), promotions, early.getTime()).keys()], ["tripod"]);
  assert.equal(activePromotions(items.map((item) => ({ ...item, active: false })), promotions, early.getTime()).size, 0);
  assert.equal(activePromotions(items, promotions, start.getTime() + 7 * day).get("tripod")?.id, extension);
  assert.equal(activePromotions(items, promotions, start.getTime() + 14 * day).size, 0);
  asActor("naya");
  assert.throws(() => createPromotion("tripod"), /pemilik/);
  await assert.rejects(confirmSimulatedPayment("promotion", first, "raka"), /Akun pembayar/);
  assert.equal(paymentReceipt("promotion", first), undefined);
  asActor("admin");
  assert.equal(adminRecords().receipts.filter((row) => row.kind === "promotion").length, 3);
});

test("foto wajib, migrasi, kepemilikan, moderasi, dan riwayat", async () => {
  asActor("raka");
  const base = snapshot().items.find((item) => item.id === "tripod")!;
  const legacy = { ...base, id: "lama", name: "Barang lama", tile: undefined };
  const old = readState();
  old.items.push(legacy);
  writeState(old);
  assert.ok(snapshot().items.some((item) => item.id === legacy.id));
  assert.deepEqual(filterItems(snapshot().items, legacy.name, "", "", ""), []);
  assert.throws(() => addItem(legacy, 20000), /minimal satu foto/);
  assert.throws(() => createPromotion(legacy.id), /aktif/);
  asActor("naya");
  assert.throws(() => requestLoan(legacy.id, at(12), at(13), legacy.points[0]), /tidak ditemukan/);
  assert.throws(() => removeListing(legacy.id, "archive"), /pemilik/);
  assert.throws(() => addItem(base, 20000, legacy.id), /akun aktif/);
  asActor("raka");
  addItem({ ...legacy, photos: ["tile:4"] }, 20000, legacy.id);
  assert.equal(filterItems(snapshot().items, legacy.name, "", "", "").length, 1);
  assert.throws(() => addItem({ ...legacy, photos: [] }, 20000, legacy.id), /minimal satu/);
  const purchase = createPromotion(legacy.id);
  await confirmSimulatedPayment("promotion", purchase.id, "raka");
  removeListing(legacy.id, "archive");
  assert.equal(activePromotions(snapshot().items, snapshot().promotions, Date.now()).has(legacy.id), false);
  assert.equal(filterItems(snapshot().items, legacy.name, "", "", "").length, 0);
  assert.throws(() => createPromotion(legacy.id), /aktif/);
  asActor("naya");
  assert.throws(() => removeListing("stand", "archive"), /transaksi aktif/);
  asActor("admin");
  assert.throws(() => removeListing("stand", "hide"), /alasan/);
  removeListing("stand", "hide", "Pemeriksaan kondisi");
  const stand = snapshot().items.find((item) => item.id === "stand")!;
  assert.equal(stand.moderation?.[0].actor, "admin");
  assert.ok(stand.moderation?.[0].at);
  asActor("raka");
  assert.throws(() => requestLoan("stand", at(90), at(91), stand.points[0]), /tidak ditemukan/);
  changeStatus("demo-stand", "returning");
  asActor("naya");
  changeStatus("demo-stand", "completed");
  asActor("admin");
  removeListing("stand", "archive", "Pemeriksaan selesai");
  assert.equal(snapshot().loans.find((loan) => loan.id === "demo-stand")?.status, "completed");
  assert.ok(snapshot().items.find((item) => item.id === "stand")?.archivedAt);
});
