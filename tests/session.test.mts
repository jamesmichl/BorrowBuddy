import assert from "node:assert/strict";
import { test } from "node:test";
import { randomBytes } from "node:crypto";
import { mkdtempSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { spawnSync } from "node:child_process";
import { database, readState } from "../server/database.ts";
import { actorFor, lifetime, revoke, signIn } from "../server/auth.ts";
import { operation, sessionView } from "../server/operations.ts";
import { domain } from "../server/domain.ts";

const root = mkdtempSync(join(tmpdir(),"bb-session-"));
process.env.BORROWBUDDY_DB = join(root,"session.sqlite");
const secrets = Object.fromEntries(["raka","naya","admin"].map(id => [id,randomBytes(20).toString("hex")]));
function run(script: string, args: string[] = [], input = "{}", env = {}) {
  return spawnSync(process.execPath, ["--experimental-strip-types", "scripts/" + script + ".mts", ...args], {
    input, encoding: "utf8", env: { ...process.env, NODE_ENV: "development", BORROWBUDDY_DEMO_SEED: "1", ...env },
  });
}
test("seed, migrasi lama, sesi server, isolasi role dan pencabutan", async () => {
  assert.notEqual(run("seed-demo",[],JSON.stringify(secrets),{NODE_ENV:"production"}).status,0);
  assert.notEqual(run("seed-demo",[],JSON.stringify(secrets),{BORROWBUDDY_DEMO_SEED:""}).status,0);
  assert.equal(run("seed-demo",[],JSON.stringify(secrets)).status,0);
  const old = readState();
  old.accounts.raka.name = "Raka (profil lama)";
  old.items.find(i=>i.id==="tripod")!.description = "Deskripsi dari browser lama";
  old.loans[0].status = "returning";
  old.person = "admin";
  const file = join(root,"legacy.json");
  writeFileSync(file,JSON.stringify(old));
  assert.equal(run("import-legacy",[file]).status,0);
  const imported = readState();
  assert.equal(imported.loans[0].status,"returning");
  assert.equal(imported.accounts.raka.name,old.accounts.raka.name);
  assert.equal(imported.person,"");
  assert.equal(run("import-legacy",[file]).status,0);
  const hashes = () => database().prepare("SELECT id,secret FROM identities ORDER BY id").all();
  const originalHashes = hashes();
  assert.equal(run("seed-demo").status,0);
  assert.deepEqual(readState(), imported);
  assert.deepEqual(hashes(),originalHashes);
  assert.equal(hashes().length,3);
  await assert.rejects(()=>signIn("raka@borrowbuddy.test",secrets.naya),/tidak sesuai/);
  const r = await signIn("raka@borrowbuddy.test",secrets.raka);
  const n = await signIn("naya@borrowbuddy.test",secrets.naya);
  const a = await signIn("admin@borrowbuddy.test",secrets.admin);
  assert.deepEqual([r.role,n.role,a.role],["student","student","admin"]);
  assert.equal(await actorFor(r.token),"raka");
  await assert.rejects(()=>operation(undefined,"admin","reviewVerification",[]),/Masuk/);
  await assert.rejects(()=>operation(r.token,"admin","updateProfile",["Nama lain"]),/Sesi/);
  await assert.rejects(()=>operation(r.token,"raka","reviewVerification",["naya","approved",""]),/ditolak/);
  await assert.rejects(()=>operation(r.token,"raka","updateProfile",["Raka","admin"]),/valid/);
  await assert.rejects(()=>operation(r.token,"raka","selectPerson",["admin"]),/tersedia/);
  await operation(r.token,"raka","updateProfile",["Raka Pengujian"]);
  assert.equal(readState().accounts.raka.role,"student");
  const getView = async (token?: string) => domain(readState(),await actorFor(token),()=>{}).view();
  assert.equal((await getView(r.token)).admin,undefined);
  assert.ok((await getView(a.token)).admin);
  assert.equal((await getView(n.token)).valuations.tripod,undefined);
  assert.equal((await getView()).loans.length,0);
  assert.equal((await getView(r.token)).profile?.email,"raka@borrowbuddy.test");
  assert.equal((await getView(n.token)).profile?.email,"naya@borrowbuddy.test");
  assert.equal(readState().items.find(i=>i.id==="tripod")?.owner,"raka");
  assert.equal(readState().loans[0].borrower,"raka");
  await assert.rejects(() => operation(r.token,"raka","removeListing",["stand","hide","Alasan"]), /pemilik atau admin/);
  await assert.rejects(() => operation(a.token,"admin","removeListing",["stand","hide"," "]), /alasan/);
  await assert.rejects(() => operation(a.token,"admin","changeStatus",["demo-stand","completed"]), /tidak ditemukan/);
  const before = (await sessionView(a.token)).loans;
  await operation(a.token,"admin","removeListing",["stand","hide","Periksa kondisi"]);
  const moderated = await sessionView(a.token);
  assert.deepEqual(moderated.loans, before);
  const record = moderated.items.find(item => item.id === "stand")?.moderation?.at(-1);
  assert.deepEqual([record?.actor,record?.action,record?.reason], ["admin","hide","Periksa kondisi"]);
  assert.ok(Date.parse(record!.at));
  assert.ok(!(await sessionView()).items.some(item => item.id === "stand"));
  assert.ok(!(await sessionView(r.token)).items.find(item => item.id === "stand")?.moderation);
  await revoke(a.token);
  const loggedOut = await sessionView(a.token);
  assert.equal(loggedOut.admin, undefined);
  assert.deepEqual(loggedOut.loans, []);
  await assert.rejects(() => operation(a.token,"admin","removeListing",["charger","archive","Alasan"]), /Masuk/);
  await revoke(r.token);
  assert.equal((await getView(r.token)).profile,undefined);
  assert.equal(await actorFor(n.token),"naya");
  database().prepare("UPDATE sessions SET expires=? WHERE account=?").run(Date.now()-lifetime,"naya");
  assert.equal(await actorFor(n.token),"");
});
