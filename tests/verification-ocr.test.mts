import assert from "node:assert/strict";
import { test } from "node:test";
import { readFileSync, mkdtempSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import sharp from "sharp";
import { randomUUID } from "node:crypto";
import { confirmEmail, encodePassword, register, signIn } from "../server/auth.ts";
import { database, readState, writeState } from "../server/database.ts";
import { domain, makeSeed } from "../server/domain.ts";
import { verifySubmission } from "../server/submit-verification.ts";
import { operation } from "../server/operations.ts";
import { inspectPhoto } from "../server/ocr.ts";
import { assessNim } from "../server/ocr-result.ts";

const encode = (bytes: Buffer) => "data:image/png;base64," + bytes.toString("base64");
const sample = (variant: string) => readFileSync(new URL("../server/samples/" + variant + ".png",import.meta.url));
test("OCR lokal, unggah ulang, isolasi data, keputusan admin dan batas produksi",async () => {
  process.env.BORROWBUDDY_DEMO_SEED = "1";
  process.env.BORROWBUDDY_DB = join(mkdtempSync(join(tmpdir(),"bb-ocr-")),"test.sqlite");
  writeState(makeSeed());
  const pass = randomUUID(), nim = "1234567890", email = "tester@binus.ac.id";
  await confirmEmail(await register("Mahasiswa Uji",email,pass,pass));
  const user = await signIn(email,pass);
  database().prepare("INSERT INTO identities VALUES(?,?,?)").run("admin","admin@borrowbuddy.test",encodePassword(pass));
  const admin = await signIn("admin@borrowbuddy.test",pass);
  const photo = encode(sample("match"));
  const submit = (image: string) => verifySubmission(user.token,user.id,[nim,"Kemanggisan",image]);
  const latest = () => readState().verifications[user.id]?.[0];
  const review = (status: string, id: string) => operation(admin.token,"admin","reviewVerification",[user.id,status,status === "approved" ? "" : "Perjelas foto",id]);
  await assert.rejects(verifySubmission(user.token,user.id,[nim,"Kemanggisan",photo,"approved"]),/valid/);
  await assert.rejects(()=>operation(user.token,user.id,"submitVerification",[nim,"Kemanggisan",photo]),/tersedia/);
  await assert.rejects(inspectPhoto(nim,photo,1),/Pemeriksaan gagal diproses/);
  await assert.rejects(submit(encode(Buffer.from("bukan gambar"))),/Gambar tidak dapat dibaca/);
  assert.equal(latest(),undefined);
  await submit(encode(sample("missing")));
  assert.equal(latest().ocr?.outcome,"missing");
  assert.equal(latest().status,"autoRejected");
  assert.equal(domain(readState(),"admin",writeState).adminRecords().queue.length,0);
  await assert.rejects(()=>review("approved",latest().id!),/tidak dapat/);
  await submit(encode(sample("mismatch")));
  assert.equal(latest().ocr?.outcome,"mismatch");
  assert.equal(latest().ocr?.detected,"9876543210");
  await submit(encode(await sharp(sample("match")).blur(6).png().toBuffer()));
  assert.equal(latest().status,"retake");
  const pending = submit(photo);
  await assert.rejects(submit(encode(sample("mismatch"))),/berlangsung/);
  await pending;
  assert.equal(latest().status,"pending");
  assert.equal(latest().demo,true);
  assert.equal(latest().ocr?.detected,nim);
  assert.ok(latest().ocr?.digest);
  const firstId = latest().id!;
  await review("revision",firstId);
  await submit(photo);
  await assert.rejects(()=>review("approved",firstId),/tidak dapat/);
  await review("approved",latest().id!);
  const view = (id: string) => domain(readState(),id,writeState).view();
  assert.equal(view(user.id).verificationStatus,"approved");
  assert.equal(view("naya").document,undefined);
  assert.doesNotMatch(JSON.stringify(view("")),/1234567890|9876543210/);
  assert.equal(view("raka").verificationStatus,"approved");
  const original = process.env.NODE_ENV;
  try {
    Object.assign(process.env,{NODE_ENV:"production"});
    assert.equal(view("raka").verificationStatus,"none");
    assert.equal(view("naya").verificationStatus,"none");
    assert.equal(view(user.id).verificationStatus,"revision");
    assert.equal(view(user.id).demoVerification,false);
    await assert.rejects(inspectPhoto(nim,photo),/pengujian lokal/);
  } finally { if (original) Object.assign(process.env,{NODE_ENV:original}); else Reflect.deleteProperty(process.env,"NODE_ENV"); }
});
test("angka tanpa label, digit ambigu, dan confidence rendah", () => {
  const assess = (text: string, confidence = 95) => assessNim([text.split(" ").map(text=>({text,confidence}))],"1234567890",75,false);
  assert.equal(assess("Nomor latihan: 1234567890").outcome,"missing");
  assert.equal(assess("NIM: 12345-67890").outcome,"match");
  assert.equal(assess("NIM: 12345 6789O").outcome,"uncertain");
  assert.equal(assess("NIM: 1234567890",60).outcome,"uncertain");
});
