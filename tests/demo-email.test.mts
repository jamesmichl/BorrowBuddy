import assert from "node:assert/strict";
import { test } from "node:test";
import { randomUUID } from "node:crypto";
import { mkdtempSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { actorFor, confirmDemoRegistration, confirmEmail, register, registerDemoEmail, revoke, signIn } from "../server/auth.ts";
import { database, readState, writeState } from "../server/database.ts";
import { emailDelivery } from "../server/email-delivery.ts";
import { domain, makeSeed } from "../server/domain.ts";
import { loginDestination } from "../server/login-destination.ts";

test("konfirmasi demo hanya untuk pendaftaran dan browser asal di development", async () => {
  process.env.BORROWBUDDY_DB = join(mkdtempSync(join(tmpdir(),"bb-email-")),"test.sqlite");
  Object.assign(process.env,{NODE_ENV:"development"});
  for (const key of ["BORROWBUDDY_MAIL_KEY","BORROWBUDDY_MAIL_FROM","BORROWBUDDY_APP_URL","BORROWBUDDY_DEMO_EMAIL"]) delete process.env[key];
  const seed = makeSeed();
  writeState(seed);
  assert.equal(emailDelivery().mode,"demo");
  const pass = randomUUID(), email = "penguji@binus.ac.id";
  const signup = () => registerDemoEmail("Penguji", email, pass, pass);
  const first = await signup();
  await assert.rejects(()=>signIn(email,pass),/Konfirmasi/);
  await assert.rejects(()=>confirmEmail(first.ticket),/tidak valid/);
  await assert.rejects(()=>confirmDemoRegistration(first.ticket),/browser/);
  const other = await registerDemoEmail("Penguji Lain","lain@binus.ac.id",pass,pass);
  await assert.rejects(()=>confirmDemoRegistration(first.ticket,other.proof),/tidak valid/);
  database().prepare("UPDATE confirmations SET expires=0").run();
  await assert.rejects(()=>confirmDemoRegistration(first.ticket,first.proof),/kedaluwarsa/);
  const fresh = await signup();
  Object.assign(process.env,{NODE_ENV:"production",BORROWBUDDY_DEMO_EMAIL:"1"});
  assert.equal(emailDelivery().mode,"unavailable");
  await assert.rejects(signup,/tidak tersedia/);
  await assert.rejects(()=>confirmDemoRegistration(fresh.ticket,fresh.proof),/tidak tersedia/);
  Object.assign(process.env,{NODE_ENV:"development"});
  await confirmDemoRegistration(fresh.ticket,fresh.proof);
  await assert.rejects(()=>confirmDemoRegistration(fresh.ticket,fresh.proof),/tidak valid/);
  const auth = await signIn(email,pass);
  const view = domain(readState(),await actorFor(auth.token),writeState).view();
  assert.equal(view.profile?.confirmed,true);
  assert.equal(view.verificationStatus,"none");
  assert.equal(loginDestination(undefined,view),"/");
  await assert.rejects(()=>signIn("lain@binus.ac.id",pass),/Konfirmasi/);
  Object.assign(process.env,{NODE_ENV:"production"});
  await assert.rejects(()=>signIn(email,pass),/Konfirmasi/);
  assert.equal(await actorFor(auth.token),"");
  Object.assign(process.env,{NODE_ENV:"development"});
  await revoke(auth.token);
  assert.equal(await actorFor(auth.token),"");
  for (const id of ["raka","naya","admin"]) assert.deepEqual(readState().accounts[id],seed.accounts[id]);
  const realToken = await register("Lain","mail@binus.ac.id",pass,pass);
  await assert.rejects(()=>registerDemoEmail("Lain","mail@binus.ac.id",pass,pass),/terdaftar/);
  await confirmEmail(realToken);
  delete process.env.BORROWBUDDY_DEMO_EMAIL;
  process.env.BORROWBUDDY_MAIL_FROM = "example@example.test";
  assert.equal(emailDelivery().mode,"unavailable");
  Object.assign(process.env,{BORROWBUDDY_MAIL_KEY:"test",BORROWBUDDY_APP_URL:"http://localhost:3000"});
  assert.equal(emailDelivery().mode,"resend");
  Object.assign(process.env,{NODE_ENV:"production",BORROWBUDDY_DEMO_EMAIL:"1"});
  assert.equal(emailDelivery().mode,"resend");
  await confirmEmail(await register("Penguji",email,pass,pass));
  assert.equal(await actorFor((await signIn(email,pass)).token),auth.id);
});
